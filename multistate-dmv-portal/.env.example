# Public site origin used for Stripe return URLs.
# On Netlify this can be omitted; checkout uses the request origin.
CLIENT_URL=https://your-site.netlify.app
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PORT=3001
NODE_ENV=production
# Set to true to require an X-Membership header of active or trialing.
ENFORCE_MEMBERSHIP=false
